# GPU image — requires NVIDIA Container Toolkit.
# Build: ./scripts/docker.sh build-gpu
FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/app/.cache/huggingface \
    TRANSFORMERS_CACHE=/app/.cache/huggingface \
    XDG_CACHE_HOME=/app/.cache

# Ubuntu 22.04 ships Python 3.10; do not pin python3.12 (not in default apt).
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 \
        python3-venv \
        python3-pip \
        ffmpeg \
        libsndfile1 \
        git \
        curl \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3 /usr/local/bin/python \
    && ln -sf /usr/bin/python3 /usr/local/bin/python3

WORKDIR /app

COPY pyproject.toml README.md ./
COPY adapters ./adapters
COPY bench ./bench
COPY streaming ./streaming
COPY scripts ./scripts
COPY configs ./configs
COPY fixtures ./fixtures

# CUDA torch wheel, then project deps (skip CPU torch from pyproject by installing
# torch first so pip resolves the already-present package).
RUN pip3 install --upgrade pip \
    && pip3 install --index-url https://download.pytorch.org/whl/cu124 \
        torch \
    && pip3 install -e . \
    && pip3 install "datasets>=2.19.0"

RUN mkdir -p /app/data /app/results /app/.cache

EXPOSE 8000

CMD ["stream", "--host", "0.0.0.0", "--port", "8000"]
